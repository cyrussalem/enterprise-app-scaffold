{
  "name": "enterprise-app-scaffold",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAPI-first TypeScript REST API on API Gateway + Lambda",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist coverage .aws-sam packaged-template.yaml",
    "test": "jest --config jest.config.cjs",
    "test:unit": "jest --config jest.config.cjs --selectProjects unit --runInBand",
    "test:integration": "jest --config jest.config.cjs --selectProjects integration --runInBand",
    "db:start": "docker compose -f docker-compose.test.yml up -d --wait postgres",
    "db:stop": "docker compose -f docker-compose.test.yml down -v",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:generate": "sequelize-cli migration:generate --name",
    "integration:up": "docker compose -f docker-compose.test.yml up -d --wait postgres cognito",
    "integration:down": "docker compose -f docker-compose.test.yml down -v && npm run sam:local:stop",
    "integration:seed": "node test/setup/seed-integration.js && node test/setup/seed-devices.js",
    "dev:up": "npm run integration:up && npm run build && npm run integration:seed",
    "dev:down": "npm run integration:down",
    "dev:seed": "npm run build && npm run integration:seed",
    "local:start": "node scripts/local-server.js",
    "dev:api": "npm run local:start",
    "dev:web": "npm --prefix web run dev",
    "sam:build": "sam build --template-file infra/template.yaml",
    "sam:local:start": "sam local start-api --template infra/template.yaml --port 3000 --env-vars infra/env.local.json --debug",
    "sam:local:stop": "node scripts/sam-local-stop.js",
    "pretest:integration:local": "npm run integration:up && npm run build && npm run integration:seed",
    "posttest:integration:local": "npm run integration:down",
    "test:integration:local": "cross-env WAIT_ON_TIMEOUT=30000 start-server-and-test local:start tcp:127.0.0.1:3000 test:integration",
    "package:test": "aws cloudformation package --template-file infra/template.yaml --s3-bucket $ARTIFACT_BUCKET --output-template-file packaged-template.yaml",
    "deploy:test": "aws cloudformation deploy --template-file infra/template.yaml --stack-name enterprise-app-test --capabilities CAPABILITY_IAM --parameter-overrides Environment=test"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.153",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "sequelize-cli": "^6.6.5",
    "start-server-and-test": "^2.1.1",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1032.0",
    "pg": "^8.20.0",
    "sequelize": "^6.37.8"
  }
}
